# Copy to .env and fill in values
# SPONSOR_API_KEY=your_key_here
# ADAPTION_API_KEY=your_key_here  # only if using Adaption
# Agent layer (agent/llm.py). Names only; values stay in your local .env or cloud config.
# STITCH_PROVIDER=stub            # stub | anthropic | bedrock
# STITCH_MODEL=claude-opus-5-5
# STITCH_EFFORT=high
# ANTHROPIC_API_KEY=...           # for STITCH_PROVIDER=anthropic
# AWS_PROFILE=...                 # for STITCH_PROVIDER=bedrock (your local profile name)
# AWS_REGION=us-west-2
